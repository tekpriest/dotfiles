// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "model_parameters": [],
    "default_model": {
      "provider": "deepseek",
      "model": "deepseek-chat"
    },
  },
  "telemetry": {
    "metrics": false,
    "diagnostics": false
  },
  "vim_mode": true,
  "ui_font_size": 12,
  "buffer_font_size": 10,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Kanagawa Wave"
  },
  "buffer_font_family": "OperatorMonoLig Nerd Font Mono",
  "base_keymap": "Atom",
  "current_line_highlight": "gutter",
  "cursor_blink": false,
  "scrollbar": {
    "show": "never"
  },
  "tab_bar": {
    "show": false
  },
  "toolbar": {
    "quick_actions": false,
    "selections_menu": false
  },
  "format_on_save": "off",
  "file_scan_exclusions": [
    "**/_build",
    "**/.elixir_ls",
    "**/deps",
    "**/.git",
    "**/node_modules",
    "**/.svn",
    "**/.hg"
  ],
  "journal": {
    "hour_format": "hour24"
  },
  "relative_line_numbers": true
}
