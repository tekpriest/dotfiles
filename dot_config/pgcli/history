+        jsonb_build_object('id', case when (metadata->>'user_id')::uuid is null then business_id else (metadata->>'user_id')::uuid end, 'type', case when (metadata->>'user_id')::uuid is null then 'business' else 'user' end, 'name', metadata->'beneficiary'->'params'->>'account_name') as beneficiary,
+        beneficiary as payment_method,
+        description,
+        error_message,
+        'payout' as activity,
+        correlation_id,
+        inserted_at as timestamp,
+        id,
+        'jrn:payout:payout:' || id as jrn,
+        null as merchant_reference,
+        metadata->>'transaction_hash' as transaction_hash,
+        null as source_address,
+        payment_id
+        FROM money_movements.payouts

