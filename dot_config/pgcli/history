+    WHEN u.user_id IS NOT NULL THEN u.user_id
+    WHEN u.business_id IS NOT NULL THEN u.business_id
+    ELSE (u.beneficiary::jsonb ->> 'account_id')  END,
+  retries = u.retries
+FROM updates u
+WHERE p.id = u.id;
