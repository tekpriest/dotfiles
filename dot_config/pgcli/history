# 2025-08-14 17:53:59.992377
+CREATE OR REPLACE VIEW ledger.entry_balances AS
+WITH c AS (
+SELECT CAST(sum(amount) AS NUMERIC) AS credit_total, account_id FROM ledger.credits GROUP BY account_id
+),
+d AS (
+SELECT CAST(sum(amount) AS NUMERIC) AS debit_total, account_id FROM  ledger.debits GROUP BY account_id
+),
+a AS (
+SELECT id, user_id AS owner_id, currency, type, name FROM  ledger.accounts
+)
+SELECT
+id,
+a.owner_id,
+name,
+type,
+currency,
+COALESCE(credit_total, 0) AS credit_total,
+COALESCE(debit_total, 0) AS debit_total,
+CAST(CASE WHEN type IN ('liability', 'income', 'equity') THEN COALESCE(credit_total, 0) - COALESCE(debit_total, 0) ELSE COALESCE(debit_total, 0) - COALESCE(credit_total, 0) END AS NUMERIC) AS balance
+FROM a
+LEFT JOIN c ON c.account_id=a.id
+LEFT JOIN d ON d.account_id=a.id;
+

# 2025-08-14 17:54:06.874582
+CREATE OR REPLACE VIEW ledger.account_balances AS
+WITH c AS (
+  SELECT CAST(sum(amount) AS NUMERIC) AS credit, credit_account_id AS account_id FROM ledger.entries GROUP BY credit_account_id
+),
+d AS (
+  SELECT CAST(sum(amount) AS NUMERIC) AS debit, debit_account_id AS account_id FROM ledger.entries GROUP BY debit_account_id
+),
+a AS (
+  SELECT id, user_id AS owner_id, currency, type, name FROM  ledger.accounts
+)
+SELECT
+  id,
+  a.owner_id,
+  name,
+  type,
+  currency,
+  COALESCE(credit, 0) AS credit,
+  COALESCE(debit, 0) AS debit,
+  CAST(CASE WHEN type IN ('asset', 'expense') THEN COALESCE(debit, 0) - COALESCE(credit, 0) ELSE COALESCE(credit, 0) - COALESCE(debit, 0) END AS NUMERIC) AS balance
+FROM a
+LEFT JOIN c ON c.account_id=a.id
+LEFT JOIN d ON d.account_id=a.id;
+

