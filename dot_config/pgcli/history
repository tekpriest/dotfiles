+  SELECT
+    id,
+    (metadata->>'batch_id')::uuid AS batch_id,
+    (metadata->>'sender')::jsonb AS sender,
+    (metadata->>'correlation_id')::uuid AS correlation_id,
+    (metadata->>'beneficiary')::jsonb AS beneficiary,
+    (metadata->>'idempotency_key')::uuid AS idempotency_key,
+    COALESCE((metadata->>'description'), 'Payout') AS description,
+    (metadata->>'payment_id')::uuid AS payment_id,
+    (metadata->>'provider') AS provider,
+    (metadata->>'user_id')::uuid AS user_id,
+    (metadata->>'business_id')::uuid AS business_id,
+    json_build_object(
+    'max', COALESCE((metadata->>'max_retries')::int, 10),
+    'count', COALESCE((metadata->>'num_retries')::int, 10)
+    ) AS retries
+  FROM money_movements.payouts
+  WHERE sender IS NULL
