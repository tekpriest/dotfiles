# 2025-06-04 15:32:34.985606
+CREATE OR REPLACE FUNCTION normalize_amount(currency TEXT, amount NUMERIC)
+RETURNS BIGINT AS $$
+DECLARE
+  result BIGINT;
+BEGIN
+  CASE UPPER(currency)
+    WHEN 'NGN' THEN result := (amount * 100)::BIGINT;
+    WHEN 'USD' THEN result := (amount * 100)::BIGINT;
+    WHEN 'CAD' THEN result := (amount * 100)::BIGINT;
+    WHEN 'BUSD' THEN result := (amount * 100)::BIGINT;
+    WHEN 'USDT' THEN result := (amount * 100)::BIGINT;
+    WHEN 'USDC' THEN result := (amount * 100)::BIGINT;
+    WHEN 'ADA' THEN result := (amount * 1000000)::BIGINT;
+    WHEN 'ETH' THEN result := (amount * 1000000000000000000)::BIGINT;
+    WHEN 'BTC' THEN result := (amount * 100000000)::BIGINT;
+    WHEN 'TRX' THEN result := (amount * 1000000)::BIGINT;
+    WHEN 'AVAX' THEN result := (amount * 1000000)::BIGINT;
+    WHEN 'DOGE' THEN result := (amount * 100000000)::BIGINT;
+    WHEN 'XRP' THEN result := (amount * 1000000)::BIGINT;
+    WHEN 'SOL' THEN result := (amount * 1000000000)::BIGINT;
+    ELSE
+      RAISE EXCEPTION 'Unsupported currency: %', currency;
+  END CASE;
+
+  RETURN result;
+END;
+$$ LANGUAGE plpgsql IMMUTABLE STRICT;
