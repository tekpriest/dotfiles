# 2025-06-05 10:46:07.746652
+WITH updates AS (
+  SELECT
+    id,
+    (metadata->>'batch_id') AS batch_id,
+    (metadata->>'sender') AS sender,
+    (metadata->>'correlation_id') AS correlation_id,
+    (metadata->>'beneficiary') AS beneficiary,
+    (metadata->>'idempotency_key') AS idempotency_key,
+    (metadata->>'description') AS description,
+    (metadata->>'payment_id') AS payment_id,
+    (metadata->>'provider') AS provider,
+    (metadata->>'user_id') AS user_id,
+    (metadata->>'business_id') AS business_id,
+    json_build_object(
+      'max', COALESCE((metadata->>'max_retries')::int, 10),
+      'count', COALESCE((metadata->>'num_retries')::int, 10),
+    ) AS retries
+    FROM payouts
+    WHERE sender IS NULL
+)
+UPDATE payouts p
+SET
+  batch_id = u.batch_id,
+  sender = u.sender,
+  correlation_id = u.correlation_id,
+  beneficiary = u.beneficiary,
+  idempotency_key = u.idempotency_key,
+  description = u.description,
+  payment_id = u.payment_id,
+  provider = LOWER(u.provider),
+  account_id = CASE
+    WHEN u.user_id IS NULL THEN u.business_id
+    WHEN u.business_id = '3d6c9e2e-1caf-4807-97ff-bbd35fc4dc1b' THEN u.user_id
+    ELSE u.user_id
+  END,
+  retries = u.retries
+FROM updates u
+WHERE p.id = u.id;
+

