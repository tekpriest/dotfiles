# 2025-08-14 16:27:31.991430
+    CREATE OR REPLACE VIEW ledger.account_balances AS
+    WITH c AS (
+      SELECT CAST(sum(amount) AS NUMERIC) AS credit, credit_account_id AS account_id FROM ledger.entries GROUP BY credit_account_id
+    ),
+    d AS (
+      SELECT CAST(sum(amount) AS NUMERIC) AS debit, debit_account_id AS account_id FROM  ledger.entries GROUP BY debit_account_id
+    ),
+    a AS (
+      SELECT id, user_id AS owner_id, currency, type, name FROM  ledger.accounts
+    )
+    SELECT
+      id,
+      a.owner_id,
+      name,
+      type,
+      currency,
+      COALESCE(credit, 0) AS credit,
+      COALESCE(debit, 0) AS debit,
+      CAST(CASE WHEN type IN 'asset', 'expense') THEN COALESCE(debit, 0) - COALESCE(credit, 0) ELSE COALESCE(credit, 0) - COALESCE(debit, 0) END AS NUMERIC) AS balance
+    FROM a
+    LEFT JOIN c ON c.account_id=a.id
+    LEFT JOIN d ON d.account_id=a.id;

