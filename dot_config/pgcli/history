+CREATE OR REPLACE FUNCTION normalize_amount(currency TEXT, amount NUMERIC)
+RETURNS BIGINT AS $$
+BEGIN
+  RETURN CASE UPPER(currency)
+   WHEN 'NGN' THEN (amount * 100)::BIGINT
+    WHEN 'USD' THEN (amount * 100)::BIGINT
+    WHEN 'CAD' THEN (amount * 100)::BIGINT
+    WHEN 'BUSD' THEN (amount * 100)::BIGINT
+    WHEN 'USDT' THEN (amount * 100)::BIGINT
+    WHEN 'USDC' THEN (amount * 100)::BIGINT
+    WHEN 'ADA' THEN (amount * 1000000)::BIGINT
+    WHEN 'ETH' THEN (amount * 1000000000000000000)::BIGINT
+    WHEN 'BTC' THEN (amount * 100000000)::BIGINT
+    WHEN 'TRX' THEN (amount * 1000000)::BIGINT
+    WHEN 'AVAX' THEN (amount * 1000000)::BIGINT
+    WHEN 'DOGE' THEN (amount * 100000000)::BIGINT
+    WHEN 'XRP' THEN (amount * 1000000)::BIGINT
+    WHEN 'SOL' THEN (amount * 1000000000)::BIGINT
+    ELSE RAISE EXCEPTION 'Unsupported currency: %', currency 
+  END;
+END;
+$$ LANGUAGE plpgsql IMMUTABLE STRICT;
+

